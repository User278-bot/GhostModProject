{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A Minecraft Mod that displays other players as client-side ghosts, enabling pseudo-multiplayer for singleplayer maps without affecting server-side logic.",
  "authors": [
    "User278-bot"
  ],
  "contact": {
    "homepage": "https://github.com/User278-bot/GhostModProject",
    "sources": "https://github.com/User278-bot/GhostModProject",
    "issues": "https://github.com/User278-bot/GhostModProject/issues"
  },
  "license": "MIT",
  "icon": "assets/ghostmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.ghost.GhostModClient"
    ],
    "modmenu": [
      "com.ghost.config.ModMenuIntegration"
    ]
  },
  "mixins": [],
  "accessWidener": "template.accesswidener",
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "cloth-config": "*"
  }
}